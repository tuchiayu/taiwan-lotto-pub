# Git Ignore Management
# To generate language-specific ignore rules, use: https://gitignore.io

# OS generated files
.DS_Store
Thumbs.db

# IDE & Editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp

# Environment variables, Secrets & Local Databases
.env
.env.*
!.env.example
*.key
*.pem
*.db
*.sqlite
*.sqlite3

# Logs
*.log

# AI Assistants & Code Indexing (Local Databases, Caches & Rules)
.agents/
.antigravitycli/
.claude/
.cline/
.codebase-memory/
.codegraph/
.codex/
/AGENTS.md
/CLAUDE.md

# Workflow scratch files
.github/TEMP_ISSUE_BODY.md
.github/TEMP_PR_BODY.md
.github/TEMP_SHERPA_PARAMS.json

# Local-only feedback notes (see DEVELOPMENT.md 1.4)
docs/feedback.md

# Python virtual environments
venv/
.venv/
env/

# Python compiled files & tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
test-results/

# Python packaging outputs
build/
dist/
*.egg-info/
